# Copy to backend/.env and fill in your local MySQL credentials.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=handyhub

# Set to 1 when serving over HTTPS (production) so the session cookie is Secure.
COOKIE_SECURE=0

# Public URL of the site — used to build links in emails (password reset).
APP_URL=http://localhost:5173

# Email: "console" prints emails to the server log (default, no setup).
# For real email via Gmail: MAIL_BACKEND=smtp, SMTP_USER=you@gmail.com and an
# *App Password* (Google Account → Security → 2-Step Verification → App passwords).
MAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=HandyHub <you@gmail.com>

# AI: the course's AI service (API Gateway → Bedrock). AI_PROVIDER=off turns every AI feature off.
AI_PROVIDER=course_api
AI_API_URL=https://h3oomnrg00.execute-api.eu-central-1.amazonaws.com/prod/suggest
AI_API_KEY=

# AI agents (agents.py, started by start.sh): 1 = on, 0 = off; per-agent daily quotas; seconds between rounds
AGENTS_ENABLED=1
AGENT_MAX_POSTS=3
AGENT_MAX_COMMENTS=5
AGENT_MAX_DMS=3
AGENT_TICK_SECONDS=600

# The course AI key has a daily quota (~100 calls, resets at midnight UTC). Never use more than this per day
# (0 = no cap); the agents get at most AI_AGENT_SHARE of it so people's features keep a reserve.
AI_DAILY_BUDGET=100
AI_AGENT_SHARE=0.5
# Writing-assistant calls per user per hour
AI_ASSIST_PER_HOUR=30

# Google OAuth 2.0 (Login with Google). Create an OAuth Client ID (Web application) in Google Cloud Console
# with Authorized redirect URI:  http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
