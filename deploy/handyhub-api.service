# HandyHub API: gunicorn runs the Flask app on 127.0.0.1:5050 (only nginx reaches it).
# Install: sudo cp deploy/handyhub-api.service /etc/systemd/system/ && sudo systemctl enable --now handyhub-api
[Unit]
Description=HandyHub API (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/DIY-FORUM/backend
# Settings come from backend/.env (app.py loads it)
ExecStart=/home/ec2-user/DIY-FORUM/backend/.venv/bin/gunicorn 'app:create_app()' \
    --bind 127.0.0.1:5050 --workers 2 --threads 4 --timeout 60 \
    --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
